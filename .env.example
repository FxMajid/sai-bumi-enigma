# Default aman: tidak ada koneksi atau data sintetis.
# Gunakan demo secara eksplisit untuk mencoba UI. Restart server setelah mengubah.
APP_DATA_MODE=supabase

# Isi sendiri di .env.local. Jangan kirim secret melalui chat atau commit file itu.
# Backend saja: jangan menambahkan prefix NEXT_PUBLIC_ pada variabel berikut.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Alternatif legacy (JWT dengan role=service_role); isi salah satu key saja.
SUPABASE_SERVICE_ROLE_KEY=
# Opsional untuk CLI/import lokal; tidak dibaca aplikasi atau dikirim ke browser.
# Pada proyek yang telah disiapkan, password dibuat acak di .env.local.
SUPABASE_DB_PASSWORD=
SUPABASE_EVENT_SLUG=the-sai-bumi-enigma-2026
# Nama bucket privat dikelola migration; jangan mengganti tanpa migration baru.
SUPABASE_STORAGE_BUCKET=sai-bumi-team-photos
APP_ORIGIN=http://localhost:3000
# Opsional: secret acak >=32 karakter untuk pseudonim rate limit.
# Jika kosong, backend memakai key Supabase sebagai HMAC secret (tidak disimpan DB).
RATE_LIMIT_SECRET=
# Opsional: secret terpisah >=32 karakter; direkomendasikan agar rotasi key DB
# tidak membatalkan sesi upload. Default jika kosong adalah key backend.
UPLOAD_TOKEN_SECRET=
# Proxy sendiri harus menimpa X-Forwarded-For dan menyisipkan secret header
# X-Registration-Proxy-Secret. Header IP diabaikan bila secret tidak cocok.
# Vercel menggunakan X-Vercel-Forwarded-For yang disediakan platform.
TRUSTED_PROXY_SECRET=

UPLOAD_TTL_SECONDS=3600
UPLOAD_CLEANUP_GRACE_SECONDS=900
PHOTO_SIGNED_URL_SECONDS=120
RATE_LIMIT_WINDOW_SECONDS=600
RATE_LIMIT_RETENTION_SECONDS=172800
RATE_LIMIT_UPLOAD_ACTOR=20
RATE_LIMIT_UPLOAD_GLOBAL=100
RATE_LIMIT_SUBMIT_ACTOR=60
RATE_LIMIT_SUBMIT_GLOBAL=300
